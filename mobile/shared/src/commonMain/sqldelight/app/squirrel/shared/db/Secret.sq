-- Encrypted secrets (Android: the refresh token under a Keystore AES-GCM key).
CREATE TABLE secret (
    name TEXT NOT NULL PRIMARY KEY,
    iv BLOB NOT NULL,
    ciphertext BLOB NOT NULL
);

get:
SELECT * FROM secret WHERE name = ?;

put:
INSERT OR REPLACE INTO secret (name, iv, ciphertext) VALUES (?, ?, ?);

remove:
DELETE FROM secret WHERE name = ?;
