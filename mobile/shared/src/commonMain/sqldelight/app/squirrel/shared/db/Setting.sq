-- Small key-value settings (backup options, the server address).
CREATE TABLE setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

get:
SELECT value FROM setting WHERE key = ?;

put:
INSERT OR REPLACE INTO setting (key, value) VALUES (?, ?);

remove:
DELETE FROM setting WHERE key = ?;

all:
SELECT * FROM setting;

-- Sign-out or another account: forget what belonged to the device's session, keep the server
-- address and the backup preferences (they describe this phone, not the account).
removeDeviceState:
DELETE FROM setting
WHERE key != 'server.url' AND key != 'session.clear_pending' AND (key NOT LIKE 'backup.%' OR key = 'backup.last_run');
