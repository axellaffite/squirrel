{
    "name": "album",
    "description": "One album's page: its photos, rename, cover and removal (owner or write access). Reached by: albums open <id> or albums create <name>.",
    "actions": [
        {
            "name": "close_photo",
            "description": "Close the viewer. Only while a photo is open (viewing set)",
            "params": {
                "type": "object",
                "properties": {}
            }
        },
        {
            "name": "more",
            "description": "Load the next page of photos, as scrolling to the end does. Not once complete",
            "params": {
                "type": "object",
                "properties": {}
            }
        },
        {
            "name": "open",
            "description": "Open a loaded photo (by its id in photos) in the viewer. Not while one is open",
            "params": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    }
                },
                "required": [
                    "id"
                ]
            }
        },
        {
            "name": "refresh",
            "description": "Reload the album from its first page, as pulling down does",
            "params": {
                "type": "object",
                "properties": {}
            }
        },
        {
            "name": "remove",
            "description": "Take loaded photos out of the album (they stay in the timeline), as selecting them and Remove does. Owner or write access; with write, only the photos you added go",
            "params": {
                "type": "object",
                "properties": {
                    "ids": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "description": "Photo ids from photos"
                    }
                },
                "required": [
                    "ids"
                ]
            }
        },
        {
            "name": "rename",
            "description": "Rename the album, as the pencil does. Owner only",
            "params": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "name"
                ]
            }
        },
        {
            "name": "retry",
            "description": "Try the failed load again, after an error",
            "params": {
                "type": "object",
                "properties": {}
            }
        },
        {
            "name": "set_cover",
            "description": "Make a loaded photo the album's cover, as Set as cover does. Owner only",
            "params": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "description": "A photo id from photos"
                    }
                },
                "required": [
                    "id"
                ]
            }
        }
    ],
    "state": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string"
            },
            "name": {
                "type": "string",
                "description": "The album's name (as opened, until its details arrive)"
            },
            "count": {
                "type": "integer",
                "nullable": true,
                "description": "Photos in it; null until its details arrive"
            },
            "access": {
                "type": "string",
                "enum": [
                    "owner",
                    "write",
                    "read",
                    "unknown_default_open_api"
                ],
                "nullable": true,
                "description": "What you may do: owner (rename, set the cover, remove), write (remove your own photos) or read; null until its details arrive"
            },
            "sharedBy": {
                "type": "string",
                "nullable": true,
                "description": "Who shared it with you; null: your own"
            },
            "photos": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "name": {
                            "type": "string"
                        },
                        "takenAt": {
                            "type": "string",
                            "description": "Capture time on the camera's clock, e.g. 2024-07-14T18:30:05"
                        },
                        "video": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "id",
                        "name",
                        "takenAt"
                    ]
                },
                "description": "Its photos loaded so far, page by page (more)"
            },
            "complete": {
                "type": "boolean",
                "description": "Every photo of it is loaded"
            },
            "loading": {
                "type": "boolean"
            },
            "refreshing": {
                "type": "boolean"
            },
            "error": {
                "type": "string",
                "nullable": true
            },
            "viewing": {
                "type": "string",
                "nullable": true,
                "description": "The photo open in the viewer"
            },
            "notice": {
                "type": "string",
                "nullable": true,
                "description": "What the last change did"
            },
            "noticeIsError": {
                "type": "boolean",
                "description": "The notice is an error"
            }
        },
        "required": [
            "id",
            "name"
        ]
    }
}
