            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadSessionDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "uploads"
        ],
        "operationId": "abort_upload",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Upload id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Upload aborted and its bytes deleted"
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The upload is being completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/uploads/{id}/chunks/{index}": {
      "put": {
        "tags": [
          "uploads"
        ],
        "summary": "Stores one chunk at its offset. Chunks may arrive in any order and may be\nre-sent; each must have exactly the planned length.",
        "operationId": "put_chunk",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Upload id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "index",
            "in": "path",
            "description": "Zero-based chunk index",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "format": "int32",
                  "minimum": 0
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Chunk stored"
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "The upload is being completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "413": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Wrong index or length",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "507": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/uploads/{id}/complete": {
      "post": {
        "tags": [
          "uploads"
        ],
        "operationId": "complete_upload",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Upload id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "File created; its name may carry a \" (n)\" suffix if the name was taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeDto"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "upload_incomplete, already completing, or destination folder gone",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "hash_mismatch: the upload was discarded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "507": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountRequest": {
        "type": "object",
        "required": [
          "username",
          "display_name",
          "password"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "CreateFolderRequest": {
        "type": "object",
        "required": [
          "parent_id",
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "parent_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateInvitationRequest": {
        "type": "object",
        "properties": {
          "email_hint": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional reminder of who the invitation is for. Not used to send email."
          }
        }
      },
      "CreateUploadRequest": {
        "type": "object",
        "required": [
          "parent_id",
          "name",
          "size",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "parent_id": {
            "type": "string",
            "format": "uuid",
            "description": "Destination folder."
          },
          "sha256": {
            "type": "string",
            "description": "SHA-256 of the whole file, 64 lowercase hex characters."
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "Total size in bytes.",
            "minimum": 0
          }
        }
      },
      "CreatedInvitation": {
        "type": "object",
        "required": [
          "invitation",
          "token"
        ],
        "properties": {
          "invitation": {
            "$ref": "#/components/schemas/InvitationDto"
          },
          "token": {
            "type": "string",
            "description": "Shown once. Build the link as `<origin>/join/<token>`."
          }
        }
      },
      "DeduplicatedUpload": {
        "type": "object",
        "description": "The content was already in the caller's library: a node was created without\nuploading anything.",
        "required": [
          "deduplicated",
          "node"
        ],
        "properties": {
          "deduplicated": {
            "type": "boolean",
            "description": "Always `true`."
          },
          "node": {
            "$ref": "#/components/schemas/NodeDto"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, e.g. `invalid_credentials`."
          },
          "message": {
            "type": "string",
            "description": "Human-readable message, safe to display."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "InstanceSettingsDto": {
        "type": "object",
        "required": [
          "invites_admin_only"
        ],
        "properties": {
          "invites_admin_only": {
            "type": "boolean"
          }
        }
      },
      "InvitationDto": {
        "type": "object",
        "required": [
          "id",
          "status",
          "used_count",
          "max_uses",
          "expires_at",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "email_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "max_uses": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "$ref": "#/components/schemas/InvitationStatusDto"
          },
          "used_count": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "InvitationStatusDto": {
        "type": "string",
        "enum": [
          "active",
          "used",
          "expired",
          "revoked"
        ]
      },
      "JoinStatus": {
        "type": "object",
        "required": [
          "valid"
        ],
        "properties": {
          "valid": {
            "type": "boolean"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "csrf_token",
          "can_invite"
        ],
        "properties": {
          "can_invite": {
            "type": "boolean",
            "description": "Whether this user may create invitations (instance setting and role)."
          },
          "csrf_token": {
            "type": "string",
            "description": "Send back as `X-CSRF-Token` on every non-GET request."
          },
          "display_name": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "NodeDetails": {
        "type": "object",
        "required": [
          "node",
          "path"
        ],
        "properties": {
          "node": {
            "$ref": "#/components/schemas/NodeDto"
          },
          "path": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PathSegmentDto"
            },
            "description": "Ancestors from the top-level folder down, excluding the node itself."
          }
        }
      },
      "NodeDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "size",
          "is_root",
          "created_at",
          "modified_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "is_root": {
            "type": "boolean",
            "description": "Top-level folders cannot be renamed, moved or deleted."
          },
          "kind": {
            "$ref": "#/components/schemas/NodeKind"
          },
          "mime": {
            "type": [
              "string",
              "null"
            ],
            "description": "Detected from the content at upload; `null` for folders."
          },
          "modified_at": {
            "type": "string",
            "format": "date-time"
          },
          "name": {
            "type": "string"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "`null` for the top-level folders."
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "description": "Bytes; 0 for folders."
          }
        }
      },
      "NodeKind": {
        "type": "string",
        "enum": [
          "folder",
          "file"
        ]
      },
      "NodeListing": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NodeDto"
            },
            "description": "Folders first, then files; names in byte order."
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass back as `cursor` for the next page; `null` on the last page."
          }
        }
      },
      "PathSegmentDto": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "admin",
          "user"
        ]
      },
      "SetupRequest": {
        "type": "object",
        "description": "Creates the first administrator. `setup_token` is the setup code printed in\nthe server log on first start (or `SQUIRREL_SETUP_TOKEN`).",
        "required": [
          "setup_token",
          "username",
          "display_name",
          "password"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "setup_token": {
            "type": "string",
            "description": "Missing is treated like a wrong code (403), not a validation error."
          },
          "username": {
            "type": "string"
          }
        }
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "needs_setup"
        ],
        "properties": {
          "needs_setup": {
            "type": "boolean"
          }
        }
      },
      "TrashEntryDto": {
        "type": "object",
        "required": [
          "node",
          "deleted_at"
        ],
        "properties": {
          "deleted_at": {
            "type": "string",
            "format": "date-time"
          },
          "node": {
            "$ref": "#/components/schemas/NodeDto",
            "description": "`parent_id` is where it was deleted from."
          }
        }
      },
      "TrashListing": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrashEntryDto"
            },
            "description": "Newest first. Folders appear once; their contents come back with them."
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass back as `cursor` for the next page; `null` on the last page."
          }
        }
      },
      "UpdateNodeRequest": {
        "type": "object",
        "description": "Rename and/or move. At least one field is required.",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "New parent folder."
          }
        }
      },
      "UploadSessionDto": {
        "type": "object",
        "description": "An upload session: send the missing chunks, then complete it.",
        "required": [
          "upload_id",
          "chunk_size",
          "chunk_count",
          "received_chunks",
          "expires_at"
        ],
        "properties": {
          "chunk_count": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "chunk_size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "received_chunks": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "description": "Chunk indexes already stored, ascending."
          },
          "upload_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "system"
    },
    {
      "name": "setup"
    },
    {
      "name": "auth"
    },
    {
      "name": "invitations"
    },
    {
      "name": "admin"
    },
    {
      "name": "files"
    },
    {
      "name": "uploads"
    },
    {
      "name": "trash"
    },
    {
      "name": "storage"
    }
  ]
}
