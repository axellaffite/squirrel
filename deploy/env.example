# Copy to .env next to docker-compose.yml on the server, then fill in. Keep it private (chmod 600).

# Where the data directory and the Postgres files live (on the NVMe drive).
# Rootless Docker: a directory you own, e.g. /home/<you>/squirrel-data (deploy/README.md).
SQUIRREL_ROOT=/srv/squirrel

# Hex only (it goes into a database URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# The code that creates the administrator on first visit: openssl rand -hex 16
SQUIRREL_SETUP_TOKEN=

# Image tag to run (deploy/ship.sh sets it); `latest` is the last one shipped.
SQUIRREL_TAG=latest

# Address that forwarded requests come from, trusted for X-Forwarded-For. Leave unset with
# rootful Docker; rootless Docker needs the value from deploy/README.md.
#SQUIRREL_TRUSTED_PROXIES=

# Public links (deploy/README.md, "Public links"): the address Tailscale Funnel gives the public
# listener, e.g. https://<machine>.<tailnet>.ts.net:8443. Unset: nobody can make public links.
#SQUIRREL_PUBLIC_URL=
