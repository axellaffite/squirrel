{
	"name": "web",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.27.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen:api": "openapi-typescript ../openapi.json -o src/lib/api/schema.d.ts",
		"gen:native-tokens": "node scripts/native-tokens.mjs && node --experimental-strip-types --no-warnings scripts/native-icons.mjs",
		"check:native-tokens": "node --test scripts/*.test.mjs && node scripts/native-tokens.mjs --check && node --experimental-strip-types --no-warnings scripts/native-icons.mjs --check",
		"test:unit": "vitest run",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"hash-wasm": "^4.13.0",
		"openapi-fetch": "^0.17.0",
		"uqr": "0.1.2",
		"y-codemirror.next": "0.3.6",
		"y-websocket": "3.1.0",
		"yjs": "13.6.33"
	}
}
